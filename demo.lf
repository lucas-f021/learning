let a = 5;
let b = 10;
a + b;

let c = (1 + 2) * 3;
c;

let neg = -7;
neg;

let x = 8;
let y = 3;
x > y;
x < y;
x == 8;

let n = 5;
let category = 0;
if (n > 10) {
    let category = 1;
} else {
    if (n > 0) {
        let category = 2;
    } else {
        let category = 3;
    }
}
category;

let abs = fn(x) {
    if (x < 0) { return -x; }
    return x;
};
abs(-42);
abs(42);

let factorial = fn(n) {
    if (n < 2) { return 1; }
    return n * factorial(n - 1);
};
factorial(6);

let fib = fn(n) {
    if (n < 2) { return n; }
    return fib(n - 1) + fib(n - 2);
};
fib(10);

let make_adder = fn(n) { fn(x) { x + n; }; };
let add5 = make_adder(5);
let add100 = make_adder(100);
add5(10);
add100(7);
add5(1);

let apply_twice = fn(f, x) { f(f(x)); };
let inc = fn(n) { n + 1; };
apply_twice(inc, 5);

let compose = fn(f, g) { fn(x) { f(g(x)); }; };
let double = fn(x) { x * 2; };
let add1 = fn(x) { x + 1; };
let double_then_add1 = compose(add1, double);
double_then_add1(7);
